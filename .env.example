# Copie para .env e ajuste. Em desenvolvimento (docker compose up) o DATABASE_URL é substituído
# pelo Postgres local do override.

# Banco de destino, onde o schema ocr é gravado (criado do zero: veja db/destino/README.md).
# O usuário precisa de CREATE no banco (schema ocr) e, com REFERENCIAS=siga, de SELECT nas tabelas
# do SIGA lidas (veja o README). A senha vai como está, sem codificar caracteres especiais.
DESTINO_DB_HOST=banco-destino
DESTINO_DB_PORTA=5432
DESTINO_DB_NOME=ocr
DESTINO_DB_USUARIO=ocr_app
DESTINO_DB_SENHA=troque
DESTINO_DB_SSLMODE=prefer    # disable | prefer | require | verify-full
CRIAR_VIEWS=false            # o banco de destino não aceita views; a migration 0006 pula as de acurácia
# Alternativa às partes acima (se definida, vale sobre elas):
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/banco

# Armazenamento dos arquivos (MinIO incluso no compose)
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ocr-requerimentos
S3_ACCESS_KEY=ocr
S3_SECRET_KEY=ocr-segredo-troque

# Segurança: a web repassa esta chave; deixe vazio só em desenvolvimento
API_KEY=troque-por-uma-chave-longa
CORS_ORIGENS=http://localhost:3000
MAX_UPLOAD_MB=50

# OCR
MOTOR_OCR=tesseract          # tesseract | paddle (paddle exige COM_PADDLE=1 no build)
LIMIAR_CONFIANCA=80          # abaixo disso o campo vai para revisão
REMOVER_TINTA_AZUL=true      # ignora assinatura/carimbo azul sobre o texto
CONFIAR_TEXTO_SCANNER=false  # true = usa o texto que o scanner embutiu no PDF, sem refazer o OCR
CONFERIR_NUMEROS=true        # segunda leitura de CPF, coordenadas, áreas e data

# SIGA
UF=PI
SRID=4674                    # SIRGAS 2000; confira o SRID de outorga_pontointerferencia.coordenadas
REFERENCIAS=siga

# Escala
API_WORKERS=2
WORKER_CONCORRENCIA=2
PASTA_SCANNER=./entrada      # pasta (ou compartilhamento montado) onde o scanner salva
PORTA_WEB=3000
COM_PADDLE=0

# porta da API publicada no host em dev (padrão 8000)
# API_PORTA=8000
