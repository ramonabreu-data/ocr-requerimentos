# Copie para .env e ajuste. Em desenvolvimento (docker compose up) o SIGA_DATABASE_URL é substituído
# pelo Postgres local do override.

# Banco do SIGA, só leitura (pessoa pelo CPF, municípios e polígonos, procedimentos, finalidades).
# Os dados da ferramenta NÃO vão para banco: ficam em JSON no bucket abaixo. O usuário só precisa de
# SELECT nas tabelas do SIGA lidas (veja o README). A senha vai como está, sem codificar caracteres.
SIGA_DB_HOST=banco-siga
SIGA_DB_PORTA=5432
SIGA_DB_NOME=siga
SIGA_DB_USUARIO=ocr_leitura
SIGA_DB_SENHA=troque
SIGA_DB_SSLMODE=prefer       # disable | prefer | require | verify-full
# Alternativa às partes acima (se definida, vale sobre elas):
# SIGA_DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/siga

# Armazenamento: arquivos originais, imagens das páginas e os JSONs de dados (MinIO incluso no compose)
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ocr-requerimentos
S3_ACCESS_KEY=ocr
S3_SECRET_KEY=ocr-segredo-troque

# Publicação para o SIGA: o JSON padrão de cada requerimento validado (e um consolidado) no bucket do
# SIGA. Sem SIGA_S3_BUCKET a publicação fica desligada. Endpoint e credenciais vazios = os S3_* acima.
# Em desenvolvimento o override usa um bucket "siga" no MinIO local.
# SIGA_S3_BUCKET=siga
# SIGA_S3_ENDPOINT=https://minio.siga.exemplo
# SIGA_S3_ACCESS_KEY=
# SIGA_S3_SECRET_KEY=
SIGA_S3_PREFIXO=ocr-requerimentos/
SIGA_CONSOLIDADO_INTERVALO_S=300   # requerimentos.json regerado no máximo a cada 5 min

# Segurança: a web repassa esta chave; deixe vazio só em desenvolvimento
API_KEY=troque-por-uma-chave-longa
CORS_ORIGENS=http://localhost:3000
MAX_UPLOAD_MB=50

# OCR
MOTOR_OCR=tesseract          # tesseract | paddle (paddle exige COM_PADDLE=1 no build)
LIMIAR_CONFIANCA=80          # abaixo disso o campo vai para revisão
REMOVER_TINTA_AZUL=true      # ignora assinatura/carimbo azul sobre o texto
CONFIAR_TEXTO_SCANNER=false  # true = usa o texto que o scanner embutiu no PDF, sem refazer o OCR
CONFERIR_NUMEROS=true        # segunda leitura de CPF, coordenadas, áreas e data

# Índice e travas no Redis do compose (redis://redis:6379/3); prefixo das chaves
# REDIS_PREFIXO=ocr

# SIGA
UF=PI
SRID=4674                    # SIRGAS 2000; confira o SRID de outorga_pontointerferencia.coordenadas
REFERENCIAS=siga

# Escala
API_WORKERS=2
WORKER_CONCORRENCIA=2
PASTA_SCANNER=./entrada      # pasta (ou compartilhamento montado) onde o scanner salva
PORTA_WEB=3000
COM_PADDLE=0

# porta da API publicada no host em dev (padrão 8000)
# API_PORTA=8000
